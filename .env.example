# Public analytics configuration. VITE_ values are exposed to the browser.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Optional account sync. These URLs are browser-safe, but the feature stays off
# until the live Neon Auth, Data API, email, RLS, export, and deletion
# acceptance suite passes.
VITE_ACCOUNT_SYNC_ENABLED=false
VITE_NEON_AUTH_URL=
VITE_NEON_DATA_API_URL=

# Server-side secrets. Copy this file to .env.local and fill in local values.
RAPIDAPI_KEY=
# Keep disabled unless this environment is intentionally allowed to spend OCR quota.
SUDOKU_OCR_ENABLED=false
# Best-effort per-instance abuse brake; enable only after confirming a provider hard cap.
SUDOKU_OCR_MAX_CALLS_PER_IP_PER_HOUR=3

# Account database migration only. Never expose this through a VITE_ variable.
ACCOUNT_DATABASE_URL_UNPOOLED=
